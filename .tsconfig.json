{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@cloudcart/tests/*": ["tests/*"],
      "@cloudcart/support/*": ["support/*"]
    }
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "support/**/*.ts"]
}